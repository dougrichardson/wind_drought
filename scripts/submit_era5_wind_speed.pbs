#!/bin/bash -l

#PBS -P dt6
#PBS -q normalsr
#PBS -l ncpus=104
#PBS -l mem=496GB
#PBS -l jobfs=200GB
#PBS -l walltime=01:00:00
#PBS -l storage=gdata/w42+gdata/rt52+gdata/ng72+gdata/xp65+gdata/gb02
#PBS -l wd
#PBS -o /dev/null
#PBS -e /dev/null

set -euo pipefail

cd /g/data/w42/dr6273/work/wind_drought

export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

# Keep a separate pair of logs for each job.
mkdir -p logs
exec > "logs/${PBS_JOBID}.out" 2> "logs/${PBS_JOBID}.err"

# Load the Python version used to create your environment.
module use /g/data/xp65/public/modules
module load conda/analysis3

module use /g/data/gb02/public/modules/
module load dask_setup

python -u scripts/era5_wind_speed_100m.py