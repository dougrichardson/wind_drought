#!/bin/bash -l

#PBS -P dt6
#PBS -q normalsr
#PBS -l ncpus=104
#PBS -l mem=496GB
#PBS -l jobfs=300GB
#PBS -l walltime=00:20:00
#PBS -l storage=gdata/w42+gdata/ng72+gdata/xp65+gdata/gb02+gdata/rt52+gdata/ob53+gdata/if69
#PBS -l wd
#PBS -o /dev/null
#PBS -e /dev/null

set -euo pipefail

cd /g/data/w42/dr6273/work/wind_drought

export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

mkdir -p logs
exec > "logs/${PBS_JOBID}.out" 2> "logs/${PBS_JOBID}.err"

module use /g/data/xp65/public/modules
module load conda/analysis3

module use /g/data/gb02/public/modules/
module load dask_setup

: "${PYTHON_SCRIPT:?Submit with -v PYTHON_SCRIPT=path/to/script.py}"
: "${PYTHON_ARGS:?Submit with -v PYTHON_ARGS='arg1 arg2 ...'}"

if [[ ! -f "$PYTHON_SCRIPT" ]]; then
    echo "Python script not found: $PYTHON_SCRIPT" >&2
    exit 1
fi

# Convert the space-separated argument string into a Bash array
read -r -a python_args <<< "$PYTHON_ARGS"

# Simple python run:
# python -u "$PYTHON_SCRIPT" "${python_args[@]}"

# Alternative - produce additional error file focussing on python errors for simpler debugging
set +e

python -u "$PYTHON_SCRIPT" "${python_args[@]}" \
    > "logs/${PBS_JOBID}.out" \
    2> "logs/${PBS_JOBID}.err"

status=$?

if [[ $status -ne 0 ]]; then
    {
        echo "Job failed with exit status: $status"
        echo
        echo "Relevant errors:"
        grep -E -A 12 -B 2 \
            "Traceback|KeyError|ValueError|TypeError|RuntimeError|MemoryError|PermissionError|No such file|Killed" \
            "logs/${PBS_JOBID}.err" \
            || true
    } > "logs/${PBS_JOBID}.error_summary"
fi

exit "$status"