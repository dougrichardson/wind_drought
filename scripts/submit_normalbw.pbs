#!/bin/bash -l

#PBS -P dt6
#PBS -q normalbw
#PBS -l ncpus=4
#PBS -l mem=18GB
#PBS -l jobfs=20GB
#PBS -l walltime=01:00:00
#PBS -l storage=gdata/w42+gdata/ng72+gdata/xp65+gdata/gb02+gdata/rt52+gdata/ob53
#PBS -l wd
#PBS -o /dev/null
#PBS -e /dev/null

set -euo pipefail

cd /g/data/w42/dr6273/work/wind_drought

export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

# Keep a separate pair of logs for each job.
mkdir -p logs
exec > "logs/${PBS_JOBID}.out" 2> "logs/${PBS_JOBID}.err"

# Load the Python version used to create your environment.
module use /g/data/xp65/public/modules
module load conda/analysis3

: "${PYTHON_SCRIPT:?Submit with -v PYTHON_SCRIPT=path/to/script.py}"
if [[ ! -f "$PYTHON_SCRIPT" ]]; then
    echo "Python script not found: $PYTHON_SCRIPT" >&2
    exit 1
fi

: "${FIRST_YEAR:?Submit with -v FIRST_YEAR=...,LAST_YEAR=...}"
: "${LAST_YEAR:?Submit with -v FIRST_YEAR=...,LAST_YEAR=...}"

python -u "$PYTHON_SCRIPT" "$FIRST_YEAR" "$LAST_YEAR"

# Submit with e.g.: qsub -v PYTHON_SCRIPT=scripts/era5_wind_speed_100m.py,FIRST_YEAR=1979,LAST_YEAR=2025 scripts/submit_normalbw.pbs
